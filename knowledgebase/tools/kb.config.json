  "_quotes": "Documents quote messages verbatim; interpolated values are written as {name} (Python f-string and i18next {{count}} style) or <name>.",
  "quotes": {
    "min_len": 20, "max_len": 400, "min_spaces": 4,
    "starts_with": "^[A-Z\"'<(\\[]",
    "path_like_prefixes": ["backend/", "src/", "static/", "scripts/", "knowledgebase/", "/", "$", "http", "SELECT ", "UPDATE ", "INSERT ", "DELETE ", "PRAGMA ", "GET ", "POST ", "PUT ", "PATCH ", "curl ", "docker ", "uvicorn ", "npm ", "python", "pip ", "uv ", "git ", "grep ", "cd ", "sqlite3 ", "psql ", "alembic ", "export ", "WEBUI_SECRET_KEY="],
    "placeholder_patterns": ["\\{\\{[^}]*\\}\\}", "<[^>]{1,60}>", "%\\d*\\$?[sd]", "«[^»]*»", "\\{[^}]*\\}", "\\[[^\\]]*\\]", "…", "\\.\\.\\."],
    "fragment_min_len": 24, "chunk_len": 40, "long_fragment_len": 44
  },

