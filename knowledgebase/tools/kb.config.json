  "scopes": [
    {"label": "Backend API routers", "dir": "backend/open_webui/routers", "pattern": ".*\\.py", "strip": ".py", "note": "Mounted under `/api/v1/<name>` except `ollama` (`/ollama`) and `openai` (`/openai`); see backend/open_webui/main.py.", "docs": ["backend-architecture-and-request-lifecycle.md"]},
